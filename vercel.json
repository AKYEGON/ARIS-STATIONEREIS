{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.arisstationaries.co.ke" }],
      "destination": "https://arisstationaries.co.ke/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
